# Copy to .env to override the defaults. All values are optional.

# Port of the fake API (json-server). The app's dev server proxies /api to it.
API_PORT=3001

# Port of the Vite dev server.
APP_PORT=5173

# Base URL the app uses for API calls. Keep "/api" to use the dev proxy.
VITE_API_URL=/api

# Artificial API latency in milliseconds, to make loading and submitting states visible.
API_DELAY_MS=0
