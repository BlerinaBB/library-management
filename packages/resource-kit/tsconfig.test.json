{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["vitest/globals", "node"],
    // Tests, stories and Storybook config import the package by its public name, mapped to
    // the public entry (as Storybook's and Vitest's aliases do). Applications never use this.
    "paths": { "@library/resource-kit": ["./src/index.ts"] }
  },
  "include": ["src", "test", "stories", ".storybook"]
}
